# Environment variables for Bug Tracker API
# Database
DATABASE_URL=sqlite:///./bugtracker.db

# Application
APP_NAME=Bug Tracker API
APP_VERSION=1.0.0
APP_DESCRIPTION=A REST API for managing bug tracking issues

# Logging
LOG_FILE_PATH=logs/app.log

# API
API_PREFIX=
API_V1_STR=/api/v1

# CORS (comma-separated URLs)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080